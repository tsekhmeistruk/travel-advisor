{
  "name": "travel-risk-map",
  "private": true,
  "description": "Risk Monitor: world map of official travel advisories, disaster and outbreak alerts and unusual news activity, with recent changes",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "fetch": "node scripts/fetch.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/data/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"node_modules/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=85 \"tests/unit/**/*.test.mjs\" \"tests/data/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:e2e:headed": "node scripts/e2e-headed.mjs",
    "test:all": "npm test && npm run test:e2e",
    "logs": "node scripts/log-summary.mjs --days 30",
    "places:generate": "node scripts/tools/generate-places.mjs",
    "admin1:generate": "node scripts/tools/generate-admin1.mjs",
    "shots": "node scripts/tools/screenshots.mjs",
    "live-check": "node scripts/tools/live-check.mjs",
    "merge-bot-data": "node scripts/tools/merge-bot-data.mjs",
    "data:import": "node --disable-warning=ExperimentalWarning scripts/tools/import-files.mjs",
    "data:pull": "node --disable-warning=ExperimentalWarning scripts/tools/pull-data.mjs",
    "tick": "node scripts/tools/tick.mjs"
  },
  "devDependencies": {
    "i18n-iso-countries": "^7.14.0",
    "puppeteer-core": "^23.11.1"
  }
}
