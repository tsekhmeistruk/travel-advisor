{
  "name": "travel-risk-map",
  "private": true,
  "description": "World map of U.S. and Canadian travel advisory levels, updated daily",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-data.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/data/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "logs": "node scripts/log-summary.mjs --days 30"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
